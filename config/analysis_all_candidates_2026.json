    "query_prefix": "検索クエリ: ",
    "document_prefix": "検索文書: ",
    "similarity": "cosine",
    "validation_comparisons": ["cl-nagoya/ruri-v3-310m", "keyword_only"]
  },
  "candidate_sampling": {
